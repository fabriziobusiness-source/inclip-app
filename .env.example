# ───────────────────────────────────────────────────────────────
# Inclip — variables de entorno
# Copia este archivo como .env y rellena los valores de tu proyecto.
# En Netlify se cargan en Site settings → Environment variables.
#
# ⚠️ Todo lo que empieza con VITE_ viaja al navegador. Nunca pongas
#    aquí la service_role key de Supabase: esa salta el RLS y quien
#    abra el bundle podría leer y borrar toda la base.
# ───────────────────────────────────────────────────────────────

# Supabase → Project settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública de esta app. Se usa para el retorno del login con Google.
# En local: http://localhost:5173
VITE_APP_URL=https://app.inclip.com
